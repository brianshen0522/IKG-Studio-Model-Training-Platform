# Model Training Platform — deployment config. Copy to `.env`, fill every CHANGE_ME.
# Every service reads this file. Deploy with ./up.sh (not docker compose directly).

# === Database ===
POSTGRES_DB=model_trainer
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_MIGRATION_USER=migration_role
POSTGRES_MIGRATION_PASSWORD=CHANGE_ME_migration
BACKEND_DB_PASSWORD=CHANGE_ME_backend
WORKER_DB_PASSWORD=CHANGE_ME_worker
SCHEDULER_DB_PASSWORD=CHANGE_ME_scheduler

# === Redis ===
REDIS_URL=redis://redis:6379

# === MinIO (object store) ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_minio
MINIO_BUCKET=artifacts
MINIO_SECURE=false

# === App ===
NODE_ENV=production
SESSION_SECRET=CHANGE_ME_session
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password

# === Storage root(s) ===
# One or more host paths (comma-separated), bind-mounted at the same absolute path
# into every service. Lay out the contents however you like.
DATA_ROOT=/srv/model-trainer
# DATA_ROOT=/srv/model-trainer,/mnt/nas/datasets,/mnt/fast-disk/models

# === Training device ===
# cpu (default). On a GPU host, up.sh auto-detects it; set this only to pin a specific CUDA index.
TRAINING_DEVICE=cpu
# TORCH_CUDA=cu124   # optional: cu121 / cu124 / cu128, match your driver. Default cu124.

# === Web / TLS ===
# tls-proxy is the only container that publishes a port: HTTPS (self-signed, HTTP/2) on
# WEB_HTTPS_PORT. There is no such thing as a certificate valid for "every IP" (TLS SAN
# is an explicit list, not a wildcard) — any client IP still works over HTTPS, browsers
# just show a self-signed warning to click through once.
WEB_HTTPS_PORT=443
COOKIE_SECURE=true

# WebAuthn/passkeys need a real hostname (the spec has no IP-address RP ID), so they
# only work if you access the site by domain name, not by IP. If you're IP-only, leave
# passkeys unused — password login still works fine over the self-signed HTTPS.
WEBAUTHN_RP_ID=trainer.example.com
WEBAUTHN_ORIGIN=https://trainer.example.com
WEBAUTHN_RP_NAME=Model Training Platform
