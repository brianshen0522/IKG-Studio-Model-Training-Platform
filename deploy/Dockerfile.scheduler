# YOLO Trainer — Scheduler (Node/TS orchestration: reconciliation, etc.)
FROM node:24-slim
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm --filter "@model-trainer/db" --filter "@model-trainer/shared-types" build
ENV NODE_ENV=production
CMD ["node_modules/.bin/tsx", "apps/scheduler/src/index.ts"]
